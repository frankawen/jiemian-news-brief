    "shijing": {
      "title": "萚兮",
      "category": "国风·郑风",
      "original": "萚兮萚兮，风其吹女。叔兮伯兮，倡予和女。萚兮萚兮，风其漂女。叔兮伯兮，倡予要女。",
      "url": "https://www.gushiwen.cn/shiwenv_98d78626281f.aspx",
      "source": "gushiwen.cn 诗经",
      "note": "译文/注释/赏析为 guwendao 反爬动态加载，需前往原文页查看。"
    },
    "mingju": {
      "title": "叶叶红衣当酒船，细细流霞举。",
      "yiwen": "片片荷花瓣儿，像少女身上的红衣，用这花瓣儿来盛酒，把那仙酒的滋味，细细地品一品。",
      "zhushi": "叶叶：言以荷花为盛酒之具。流霞：神话中的仙酒，见《论衡·道虚篇》，此处指美酒。",
      "shangxi": "此处为动态描写，雨过天晴，细细的五彩流霞从莲荷摇曳攒动的地方冉冉升腾，是何等绚丽的景色。",
      "url": "https://www.gushiwen.cn/mingju/juv_934c38f9c9bf.aspx",
      "source": "gushiwen.cn 名句"
    },
