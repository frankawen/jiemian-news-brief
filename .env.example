# 复制本文件为 .env 并在本地测试时使用（GitHub 上请用 Repository Secrets，不要提交 .env）

# 推送方式：pushplus | serverchan | wecom
PUSH_METHOD=pushplus

# —— pushplus（推荐，免费，推送到微信服务号）——
# 获取：https://www.pushplus.plus/ 扫码登录后「一对一推送」页面复制 token
PUSHPLUS_TOKEN=

# —— Server酱（Turbo 版，推送到微信）——
# 获取：https://sct.ftqq.com/ 用微信扫码，得到 SENDKEY
SERVERCHAN_KEY=

# —— 企业微信机器人（推送到企业微信群，可转个人微信）——
# 获取：企业微信「群聊 → 添加群机器人 → 复制 webhook key」
WECOM_KEY=

# 每个栏目最多条数
MAX_ITEMS=15

# 是否仅抓取「今日」快讯（1/0）
TODAY_ONLY=1

# 时区偏移（小时），北京时间为 8
TIMEZONE_OFFSET=8

# 本地调试：设为 1 只打印不推送
DRY_RUN=1
