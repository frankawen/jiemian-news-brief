[
  {
    "path": "/mingju/juv_b928545dcd27.aspx",
    "title": "接叶巢莺，平波卷絮，断桥斜日归船。"
  },
  {
    "path": "/mingju/juv_161194925663.aspx",
    "title": "只因误识林和靖，惹得诗人说到今。"
  },
  {
    "path": "/mingju/juv_e909c8bc032a.aspx",
    "title": "如何同枝叶，各自有枯荣。"
  },
  {
    "path": "/mingju/juv_d5f39a159629.aspx",
    "title": "投躯报明主，身死为国殇。"
  },
  {
    "path": "/mingju/juv_b8cdec3873ae.aspx",
    "title": "龙蟠虎踞金陵郡，古来六代豪华盛。"
  },
  {
    "path": "/mingju/juv_8c2d09c7b3d5.aspx",
    "title": "采芳人杳，顿觉游情少。"
  },
  {
    "path": "/mingju/juv_3a1bee249aca.aspx",
    "title": "太刚则折，至察无徒"
  },
  {
    "path": "/mingju/juv_84e9e1df62e6.aspx",
    "title": "定知玉兔十分圆，化作霜风九月寒。"
  },
  {
    "path": "/mingju/juv_6f4f8913a82f.aspx",
    "title": "北山输绿涨横陂，直堑回塘滟滟时。"
  },
  {
    "path": "/mingju/juv_da600aac93bc.aspx",
    "title": "胡风吹朔雪，千里度龙山。"
  },
  {
    "path": "/mingju/juv_61a4463a1d91.aspx",
    "title": "采菱辛苦废犁锄，血指流丹鬼质枯。"
  },
  {
    "path": "/mingju/juv_26eb869953a1.aspx",
    "title": "言亦寄形于字，讽诵则绩在宫商，临文则能归字形矣。"
  },
  {
    "path": "/mingju/juv_49f92e16d99b.aspx",
    "title": "闭口深藏舌，安身处处牢。"
  },
  {
    "path": "/mingju/juv_1332a3279e5e.aspx",
    "title": "芳树无人花自落，春山一路鸟空啼。"
  },
  {
    "path": "/mingju/juv_1e20cf51d923.aspx",
    "title": "一树寒梅白玉条，迥临村路傍溪桥。"
  },
  {
    "path": "/mingju/juv_cccce3a40d18.aspx",
    "title": "杜牧司勋字牧之，清秋一首杜秋诗。"
  },
  {
    "path": "/mingju/juv_59aa3752a868.aspx",
    "title": "信则不欺，忠则无二心。"
  },
  {
    "path": "/mingju/juv_cbafd38a6045.aspx",
    "title": "万山载雪，明月薄之，月不能光，雪皆呆白。"
  },
  {
    "path": "/mingju/juv_4de2a6b33db0.aspx",
    "title": "得志，与民由之；不得志，独行其道。"
  },
  {
    "path": "/mingju/juv_3b452b1f5f84.aspx",
    "title": "有一美人兮，见之不忘。"
  },
  {
    "path": "/mingju/juv_934d8f39c5f4.aspx",
    "title": "夜阑卧听风吹雨，铁马冰河入梦来。"
  },
  {
    "path": "/mingju/juv_2c4294d514f5.aspx",
    "title": "夹岸桃花蘸水开。"
  },
  {
    "path": "/mingju/juv_509d1451de7e.aspx",
    "title": "呼星召鬼歆杯盘，山魅食时人森寒。"
  },
  {
    "path": "/mingju/juv_47e19dd33f50.aspx",
    "title": "追往事，叹今吾，春风不染白髭须。"
  },
  {
    "path": "/mingju/juv_435b377bb382.aspx",
    "title": "满眼长江水，苍然何郡山。"
  },
  {
    "path": "/mingju/juv_34c5e60b2a04.aspx",
    "title": "满目山河增感慨，一时风景寄遨游。"
  },
  {
    "path": "/mingju/juv_9a1cb9464168.aspx",
    "title": "惠崇烟雨归雁，坐我潇湘洞庭。"
  },
  {
    "path": "/mingju/juv_022b33a4bf20.aspx",
    "title": "我以不贪为宝"
  },
  {
    "path": "/mingju/juv_7b5ef68324e3.aspx",
    "title": "等闲妨了绣功夫，笑问鸳鸯两字怎生书？"
  },
  {
    "path": "/mingju/juv_a0f176d76a7a.aspx",
    "title": "饮食男女，人之大欲存焉；死亡贫苦，人之大恶存焉。"
  },
  {
    "path": "/mingju/juv_72466b755cf7.aspx",
    "title": "己有能，勿自私。人所能，勿轻訾。"
  },
  {
    "path": "/mingju/juv_3e4351a14a63.aspx",
    "title": "愿人之相美，不乐人之相伤"
  },
  {
    "path": "/mingju/juv_2c9e5873f436.aspx",
    "title": "我有所感事，结在深深肠。"
  },
  {
    "path": "/mingju/juv_f253e42171cb.aspx",
    "title": "楼上黄昏杏花寒。"
  },
  {
    "path": "/mingju/juv_b62903baac82.aspx",
    "title": "小儿误喜朱颜在，一笑那知是酒红。"
  },
  {
    "path": "/mingju/juv_a0ed0b4dd8f2.aspx",
    "title": "今夕为何夕，他乡说故乡。"
  },
  {
    "path": "/mingju/juv_1ac05f0c4f3a.aspx",
    "title": "江州司马，青衫泪湿，同是天涯。"
  },
  {
    "path": "/mingju/juv_5888a6852b70.aspx",
    "title": "绿酒初尝人易醉。一枕小窗浓睡。"
  },
  {
    "path": "/mingju/juv_4edc6ac6b050.aspx",
    "title": "病中之趣味，不可不尝；穷途之景界，不可不历。"
  },
  {
    "path": "/mingju/juv_934c38f9c9bf.aspx",
    "title": "叶叶红衣当酒船，细细流霞举。"
  },
  {
    "path": "/mingju/juv_356a55fb5fce.aspx",
    "title": "似谢家子弟，衣冠磊落；相如庭户，车骑雍容。"
  },
  {
    "path": "/mingju/juv_8b6698d4f175.aspx",
    "title": "洞房记得初相遇。"
  },
  {
    "path": "/mingju/juv_9a3efe44e5e3.aspx",
    "title": "茶为累也，亦犹人参。"
  },
  {
    "path": "/mingju/juv_f5fc6ef60606.aspx",
    "title": "童颜若可驻，何惜醉流霞。"
  },
  {
    "path": "/mingju/juv_320d217893be.aspx",
    "title": "人依远戍须看火，马踏深山不见踪。"
  },
  {
    "path": "/mingju/juv_65e64cb9989b.aspx",
    "title": "金阙晓钟开万户，玉阶仙仗拥千官。"
  },
  {
    "path": "/mingju/juv_01460697d48b.aspx",
    "title": "我见青山多妩媚，料青山见我应如是。"
  },
  {
    "path": "/mingju/juv_67d133272d9b.aspx",
    "title": "添线绣床人倦，翻香罗幕烟斜。"
  },
  {
    "path": "/mingju/juv_292fb687d28e.aspx",
    "title": "事在人为休言万般都是命，境由心造退后一步自然宽。"
  },
  {
    "path": "/mingju/juv_280724c5aa88.aspx",
    "title": "北斗七星高，哥舒夜带刀。"
  }
]